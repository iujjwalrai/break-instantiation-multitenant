#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

# The free plan has no pre-deploy step or shell, so setup runs on every boot.
python /app/manage.py migrate --noinput
python /app/manage.py createcachetable
python /app/manage.py collectstatic --noinput

if [ -n "${DJANGO_DEMO_PASSWORD:-}" ]; then
    python /app/manage.py seed_demo
fi

exec gunicorn config.asgi --bind "0.0.0.0:${PORT:-5000}" --chdir=/app -k uvicorn_worker.UvicornWorker
